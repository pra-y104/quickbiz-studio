# ---------------------------------------------------------------------------
# QuickBiz Studio - environment variable reference
# ---------------------------------------------------------------------------
# Copy this file to `.env` for local work and fill in real values.
# NEVER commit real keys. Placeholders only in the repository.
#
# The frontend is a static single-page app, so only variables prefixed with
# VITE_ are exposed to the browser. Every other value MUST stay server-side.
# ---------------------------------------------------------------------------

# ---- Frontend (apps/web) ---------------------------------------------------
# Base URL of the API worker. Local default: http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787
# Public Supabase project URL (safe to expose). Leave empty to disable
# authentication: forms stay disabled and say why.
VITE_SUPABASE_URL=
# Supabase anon (public) key. Safe to expose ONLY the anon key, never the
# service role key.
VITE_SUPABASE_ANON_KEY=
# Public app version string used for diagnostics.
VITE_APP_VERSION=0.1.0
# Public Sentry DSN (safe to expose). Leave empty to disable browser error
# monitoring; the app behaves normally with no monitoring installed.
VITE_SENTRY_DSN=

# ---- API worker (apps/api) -------------------------------------------------
# development | preview | production
ENVIRONMENT=development
APP_VERSION=0.1.0
# Comma separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rate limiting (in-memory per isolate, see docs/08-security.md)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ---- Server-only secrets (never exposed to the browser) --------------------
# Supabase project URL, used by the API to derive the token JWKS endpoint and
# issuer. Server-side only.
SUPABASE_URL=
# Optional explicit JWKS override for non-standard deployments.
SUPABASE_JWKS_URL=
# Legacy HS256 secret. Only for projects that still sign symmetric tokens.
SUPABASE_JWT_SECRET=
# Service role key: bypasses RLS. Required only once the payment/wallet ledger
# (migrations 0004/0005) is wired. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider (server-side only) ----------------------------------------
# Master switch. AI adapters are configured ONLY when this is exactly "true"
# AND a credential is present. A key alone can never start billable traffic.
# Defaults to false (fail closed).
AI_ENABLED=
# Preferred provider id / model. Naming these does NOT enable AI.
AI_PROVIDER=
AI_MODEL=
# Fallback key for the Gemini adapter (Google AI Studio).
AI_API_KEY=
GEMINI_API_KEY=
# OpenAI-compatible (Chat-Completions) provider: OpenAI, Groq, Together,
# OpenRouter, Ollama, etc. Base URL is required to register the adapter.
AI_OPENAI_BASE_URL=
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_OPENAI_PROVIDER_ID=
AI_OPENAI_LABEL=
# Require a verified email before AI runs. Defaults to "true" (fail closed).
AI_REQUIRE_VERIFIED_EMAIL=

# ---- Payments (server-side only) -------------------------------------------
# Paystack secret key. Only "sk_test_" is honoured; a live key is ignored until
# the owner explicitly approves live payments.
PAYSTACK_SECRET_KEY=
# Optional Paystack API base override (tests only).
PAYSTACK_BASE_URL=

# ---- Email (Resend, server-side only) --------------------------------------
# Resend API key. Server-side only; never exposed to the browser. When absent,
# transactional email is skipped (the app keeps working; Supabase Auth still
# sends verification/reset emails).
RESEND_API_KEY=
# Verified Resend sender, e.g. "QuickBiz <noreply@your-domain>".
RESEND_FROM_EMAIL=
# Optional Resend API base override (tests only).
RESEND_BASE_URL=

# ---- Monitoring (Sentry) ---------------------------------------------------
# Server-side Sentry DSN for API error monitoring. Leave empty to disable.
SENTRY_DSN=
# Optional Sentry environment label (defaults to ENVIRONMENT).
SENTRY_ENVIRONMENT=
# Optional Sentry release label (defaults to APP_VERSION).
SENTRY_RELEASE=

# ---- Cloudflare KV bindings (optional) -------------------------------------
# These are BINDINGS, not secrets. Declare them in wrangler.toml under
# [[kv_namespaces]] and reference the binding id. When absent, the rate limiter
# and AI quota fall back to per-isolate memory.
RATE_LIMIT_KV=
AI_QUOTA_KV=
