# ---------------------------------------------------------------------------
# Web app environment (Vite). Copy to `.env.local` for local development.
# Only VITE_* variables reach the browser bundle: treat them as public.
# ---------------------------------------------------------------------------

# Base URL of the API worker.
VITE_API_BASE_URL=http://localhost:8787

# Public Supabase project URL. Leave empty to run with authentication disabled:
# the auth screens will show a configuration notice instead of pretending to work.
VITE_SUPABASE_URL=

# Supabase anon (public) key. This is the ONLY Supabase key allowed in the
# browser. Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=

# Public app version used by diagnostics.
VITE_APP_VERSION=0.1.0
