{
  "name": "quickbiz-studio",
  "version": "0.1.0",
  "private": true,
  "description": "QuickBiz Studio - AI and everyday digital tools platform.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter @quickbiz/web dev",
    "dev:api": "pnpm --filter @quickbiz/api dev",
    "build": "pnpm --filter @quickbiz/web build && pnpm --filter @quickbiz/api build",
    "build:web": "pnpm --filter @quickbiz/web build",
    "build:api": "pnpm --filter @quickbiz/api build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
